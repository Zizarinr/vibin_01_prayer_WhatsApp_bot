# ==============================================================================
# UNIDA Prayer V2 — Template Environment
# Salin menjadi `.env` lalu isi nilai lokal Anda:  cp .env.example .env
# `.env` TIDAK di-commit (gitignored). Jangan taruh secret asli di file ini.
# ==============================================================================

# --- Mode aplikasi & runtime -----------------------------------------------
# NODE_ENV: mode runtime Bun/Next.js. Isi "development" (laptop) atau
#   "production" (server). Mempengaruhi cookie aman & optimasi build.
#   Image Docker sudah memaksa NODE_ENV=production.
NODE_ENV=development

# APP_ENV: mode perilaku aplikasi.
#   - "development" → login portal admin DI-BYPASS (langsung jadi
#     Developer dev@localhost) + CORS DIBUKA untuk origin apa pun.
#     Tujuannya: ngoprek dashboard di localhost tanpa hambatan login/CORS.
#   - "production"  → login wajib + CORS hanya allowlist di bawah.
#   Bypass aktif HANYA bila APP_ENV=development DAN NODE_ENV bukan
#   "production" (pengaman lapis dua). Server produksi WAJIB:
#   APP_ENV=production (dan NODE_ENV=production).
APP_ENV=development

# APP_SECRET: kunci HMAC penanda tangan token sesi admin. Wajib, acak,
#   minimal 32 karakter. Ganti dengan:  bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
#   Kalau diganti, semua sesi login lama otomatis hangus.
APP_SECRET=change-me-to-long-random-secret-min-32-chars

# API_PORT: port HTTP backend Elysia (default 3001).
API_PORT=3001

# --- Frontend / CORS --------------------------------------------------------
# WEB_URL: URL publik frontend. Dipakai sebagai origin CORS default
#   + label/info. Dev lokal: http://localhost:3000.
WEB_URL=http://localhost:3000

# CORS_ORIGINS: daftar origin yang boleh memanggil API (pisahkan koma).
#   Contoh multi-origin: http://localhost:3000,https://prayer.unida.gontor.ac.id
#   - Kosongkan → otomatis [WEB_URL, http://localhost:3000, http://127.0.0.1:3000].
#   - DIABAIKAN saat APP_ENV=development (CORS dibuka total untuk localhost).
#   Produksi: isi dengan domain asli agar kredensial cookie tidak bocor ke situs lain.
CORS_ORIGINS=http://localhost:3000

# --- Database (MySQL di luar Compose, lihat docs/14-panduan-mysql.md) --------
# Format: mysql://<user>:<password>@<host>:<port>/<nama_db>
# Satu database `unida_prayer` + satu user aplikasi. Contoh lokal:
DATABASE_URL=mysql://unida_prayer:CHANGE_ME@127.0.0.1:3306/unida_prayer

# --- WhatsApp Gateway (WAHA GoWS) -------------------------------------------
# WAHA_BASE_URL: alamat HTTP container WAHA.
#   Dev lokal (WAHA via Docker, port host 3000 ATAU 3008 — sesuaikan):
#   WAHA_BASE_URL=http://localhost:3000
#   Produksi (antar-container Compose): WAHA_BASE_URL=http://waha:3000
WAHA_BASE_URL=http://localhost:3000

# WAHA_API_KEY: kunci header X-Api-Key ke WAHA. Samakan dengan
#   WAHA_API_KEY milik container WAHA. Boleh kosong bila WAHA tanpa auth,
#   tapi produksi disarankan diisi.
WAHA_API_KEY=CHANGE_ME

# WAHA_SESSION: nama sesi WhatsApp (satu sesi untuk MVP, default unida-prayer).
WAHA_SESSION=unida-prayer

# --- Akses API dari frontend --------------------------------------------------
# INTERNAL_API_URL: dipakai Next.js sisi SERVER (rewrite /api/* dan SSR).
#   Dev lokal: http://127.0.0.1:3001 (atau http://localhost:3001).
#   Produksi Compose: http://api:3001 (nama service, bukan localhost).
INTERNAL_API_URL=http://localhost:3001

# NEXT_PUBLIC_API_URL: basis URL API untuk BROWSER. KOSONGKAN saja agar
#   browser memanggil same-origin "/api/..." yang di-proxy Next.js
#   (next.config.ts) — bebas masalah CORS. Isi hanya bila browser harus
#   menembak API langsung (mis. debug beda origin).
#   Contoh: NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=

# NEXT_PUBLIC_API_BASE_URL: alias lama dengan fungsi sama (masih dipakai
#   deploy/compose.yml dengan nilai "/api"). Didukung agar kompatibel;
#   NEXT_PUBLIC_API_URL diprioritaskan bila keduanya diisi.
NEXT_PUBLIC_API_BASE_URL=/api

# NEXT_PUBLIC_APP_URL: URL publik aplikasi untuk metadata/OG. Opsional.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seeding awal (hanya dipakai saat `bun run db:seed`) ----------------------
# Alternatif pengisian: argumen CLI lebih disarankan, mis.:
#   bun run db:seed --email=admin@unida.gontor.ac.id --name=Administrator --password=Min12Karakter!
# Variabel di bawah opsional; diabaikan di luar perintah seed.
# SEED_ADMIN_EMAIL: email admin utama (wajib diisi saat seed bila tanpa --email).
# SEED_ADMIN_EMAIL=admin@unida.gontor.ac.id
# SEED_ADMIN_NAME: nama tampil admin (default "Administrator").
# SEED_ADMIN_NAME=Administrator
# SEED_ADMIN_PASSWORD: kata sandi awal (min 12 karakter). Bila kosong, seed
#   mencetak password acak sekali ke stdout — segera ganti setelah login pertama.
# SEED_ADMIN_PASSWORD=
