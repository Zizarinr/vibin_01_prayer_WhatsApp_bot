# Application
NODE_ENV=development
APP_ENV=development
APP_SECRET=change-me-to-long-random-secret-min-32-chars
WEB_URL=http://localhost:3000
# Daftar origin frontend yang boleh akses API (CORS, pisahkan koma). Default: WEB_URL + localhost:3000.
CORS_ORIGINS=http://localhost:3000
API_PORT=3001

# Database - external MySQL (lihat docs/14-panduan-mysql.md)
DATABASE_URL=mysql://unida_prayer:CHANGE_ME@127.0.0.1:3306/unida_prayer

# WAHA GoWS (pin: devlikeapro/waha:gows-2026.10.1 — lihat deploy/compose.yml)
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=CHANGE_ME
WAHA_SESSION=unida-prayer

# Frontend server-side API access
INTERNAL_API_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=/api
