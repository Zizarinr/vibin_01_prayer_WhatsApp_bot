{
	"name": "unida-prayer",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "UNIDA Prayer V2 — pengingat waktu shalat via WhatsApp (monorepo Bun Workspace)",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/prayer-engine && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
		"lint": "oxlint",
		"test": "bun test",
		"build": "bun run build:api && bun run build:web",
		"build:api": "tsc --noEmit -p apps/api",
		"build:web": "cd apps/web && bun run build",
		"db:migrate": "cd apps/api && bun run db:migrate",
		"db:seed": "cd apps/api && bun run db:seed",
		"dev:api": "cd apps/api && bun run dev",
		"dev:web": "cd apps/web && bun run dev",
		"worker": "cd apps/api && bun run worker"
	},
	"dependencies": {
		"adhan": "^4.4.1",
		"dotenv": "^16.4.5",
		"node-cron": "^3.0.3",
		"qrcode-terminal": "^0.12.0",
		"whatsapp-web.js": "^1.26.0",
		"winston": "^3.17.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"bun-types": "latest",
		"oxlint": "^1.91.0",
		"typescript": "^5.9.3"
	}
}
